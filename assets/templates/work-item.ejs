```{=html}
<div class="list">
<% for (const item of items) { %>
<article class="worklist-row" <%= metadataAttrs(item) %>>
  <div class="worklist-head"><a class="worklist-title no-external" href="<%- item.path %>"><%- item.title %></a><% if (item.status || item.date) { %><span class="worklist-date"><%= item.status || item.date %></span><% } %></div>
  <% if (item.description) { %><div class="worklist-meta"><%- item.description %></div><% } %>
  <% if (item.categories && item.categories.length) { %>
  <div class="worklist-tags"><% for (const category of item.categories) { %><span class="tag"><%- category %></span><% } %></div>
  <% } %>
</article>
<% } %>
</div>
```
