<% for (const item of items) { 
const maturity = item.maturity === 'evergreen' || item.maturity === 'sprout' ? item.maturity : 'seedling';

let dateLabel = '';
if (item.date) {
  const d = item.date instanceof Date ? item.date : new Date(item.date);
  if (!isNaN(d)) {
    dateLabel = d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
  }
}
%>
```{=html}
<article class="garden-row">
<div class="garden-row-meta">
<span class="maturity-tag"><%= maturity %></span>
<% if (dateLabel) { %><time class="garden-date"><%= dateLabel %></time><% } %>
</div>
<div class="garden-row-body">
<h2 class="garden-entry-title"><a class="garden-title" href="<%- item.path %>"><%- item.title %></a></h2>
<% if (item.description) { %><p class="garden-desc"><%- item.description %></p><% } %>
<% if (item.categories && item.categories.length) { %>
<div class="garden-cats">
<% for (const c of item.categories) { %><span class="tag"><%= c %></span><% } %>
</div>
<% } %>
</div>
</article>
```
<% } %>
