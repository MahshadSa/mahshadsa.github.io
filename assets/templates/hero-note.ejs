<% for (const item of items) {
  let maturity = item.maturity === 'evergreen' || item.maturity === 'sprout' ? item.maturity : 'seedling';
  let dateLabel = '';
  if (item.date) {
    const d = item.date instanceof Date ? item.date : new Date(item.date);
    if (!isNaN(d)) {
      dateLabel = d.toLocaleDateString('en-US', {
        month: 'short',
        year: 'numeric'
      });
    }
  }
%>
<article class="worklist-row note-item"><div class="worklist-head"><span class="note-title-line"><a class="worklist-title" href="<%- item.path %>"><%- item.title %></a> <span class="maturity-tag"><%= maturity %></span></span><% if (dateLabel) { %><span class="worklist-date"><%= dateLabel %></span><% } %></div></article>
<% } %>
